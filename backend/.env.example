PORT=3000

# Database Configuration (Host/Port/Credentials)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=echo_db
DB_USER=echo_user
DB_PASSWORD=replace_with_strong_database_password

POSTGRES_DB=echo_db
POSTGRES_USER=echo_user
POSTGRES_PASSWORD=replace_with_strong_database_password

# Authentication (JWT)
JWT_SECRET=replace_with_crypto_random_64_char_base64_secret
JWT_EXPIRES_IN=7d

# AES-256-GCM encryption key for secrets at rest (32 bytes / 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_char_hex_encryption_key

# Storage Paths
STORAGE_ROOT=/storage
PROJECTS_PATH=/storage/projects
GIT_PATH=/storage/git
CLOUD_PATH=/storage/cloud
BACKUPS_PATH=/storage/backups
PUBLISHED_PATH=/storage/published
MAX_UPLOAD_SIZE=104857600

# GitHub Integration
GITHUB_WEBHOOK_SECRET=replace_with_random_32_char_secret
# GITHUB_TOKEN=ghp_optional_token_for_private_repositories

# SMTP / Email Setup (Brevo / Sendinblue / Gmail)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_user
MAIL_PASS=your_smtp_api_key_or_password
MAIL_FROM="EchoServer <noreply@yourdomain.com>"

# URLs
APP_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Nginx Proxy Manager (NPM) Integration
NPM_URL=http://localhost:81
NPM_EMAIL=admin@yourdomain.com
NPM_PASSWORD=replace_with_npm_admin_password
NPM_FORWARD_MODE=host
NPM_FORWARD_HOST=host.docker.internal

# Cloudflare Integration (Optional - for automated custom domains behind Cloudflare Tunnel / CGNAT)
# Generate token at: https://dash.cloudflare.com/profile/api-tokens with Zone.Custom Hostnames Edit permissions
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Admin Emails
SUPER_ADMIN_EMAIL=admin@yourdomain.com
ADMIN_ALERT_EMAIL=admin@yourdomain.com

