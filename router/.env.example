PORT=8080

# Database Connection (Same database as backend)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=echo_db
DB_USER=echo_user
DB_PASSWORD=replace_with_strong_database_password
DB_MAX_CONNECTIONS=25

# Target resolution: 'container' for Docker internal network, 'localhost' for local host dev
ROUTER_TARGET=container

# Caching and Proxy Timeouts
ROUTER_CACHE_TTL_MS=10000
ROUTER_TIMEOUT_MS=30000
ROUTER_PROXY_TIMEOUT_MS=30000

